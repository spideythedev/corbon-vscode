{
  "$schema": "vscode://schemas/color-theme",
  "name": "Corbon",
  "type": "dark",

  "colors": {
    "editor.background": "#0D0F12",
    "editor.foreground": "#E6E8EB",

    "editorCursor.foreground": "#7C8CFF",
    "editor.selectionBackground": "#29304A",
    "editor.inactiveSelectionBackground": "#202532",
    "editor.lineHighlightBackground": "#12151A",

    "editorLineNumber.foreground": "#4E545D",
    "editorLineNumber.activeForeground": "#AEB4BD",

    "editorIndentGuide.background1": "#1D2127",
    "editorIndentGuide.activeBackground1": "#30353D",

    "editorBracketMatch.background": "#20252D",
    "editorBracketMatch.border": "#7C8CFF",

    "editorWhitespace.foreground": "#252930",

    "editorError.foreground": "#F06A6A",
    "editorWarning.foreground": "#E5B567",
    "editorInfo.foreground": "#61C4D8",
    "editorHint.foreground": "#68C6A5",

    "editorOverviewRuler.errorForeground": "#F06A6A",
    "editorOverviewRuler.warningForeground": "#E5B567",
    "editorOverviewRuler.infoForeground": "#61C4D8",
    "editorOverviewRuler.addedForeground": "#62C58B",
    "editorOverviewRuler.modifiedForeground": "#E5B567",
    "editorOverviewRuler.deletedForeground": "#F06A6A",

    "sideBar.background": "#101318",
    "sideBar.foreground": "#C8CDD4",
    "sideBar.border": "#242831",

    "activityBar.background": "#0D0F12",
    "activityBar.foreground": "#E6E8EB",
    "activityBar.inactiveForeground": "#686F79",
    "activityBar.activeBorder": "#7C8CFF",
    "activityBar.border": "#242831",

    "statusBar.background": "#12151A",
    "statusBar.foreground": "#AEB4BD",
    "statusBar.border": "#242831",

    "titleBar.activeBackground": "#0D0F12",
    "titleBar.activeForeground": "#E6E8EB",
    "titleBar.inactiveBackground": "#0D0F12",
    "titleBar.inactiveForeground": "#686F79",
    "titleBar.border": "#242831",

    "tab.activeBackground": "#0D0F12",
    "tab.activeForeground": "#E6E8EB",
    "tab.inactiveBackground": "#101318",
    "tab.inactiveForeground": "#686F79",
    "tab.hoverBackground": "#171A20",
    "tab.activeBorderTop": "#7C8CFF",
    "tab.border": "#242831",

    "input.background": "#171A20",
    "input.foreground": "#E6E8EB",
    "input.placeholderForeground": "#686F79",
    "input.border": "#242831",

    "dropdown.background": "#171A20",
    "dropdown.foreground": "#E6E8EB",
    "dropdown.border": "#242831",

    "list.hoverBackground": "#171A20",
    "list.activeSelectionBackground": "#20252D",
    "list.activeSelectionForeground": "#E6E8EB",
    "list.inactiveSelectionBackground": "#171A20",

    "menu.background": "#171A20",
    "menu.foreground": "#E6E8EB",
    "menu.selectionBackground": "#20252D",
    "menu.selectionForeground": "#E6E8EB",
    "menu.separatorBackground": "#242831",
    "menu.border": "#242831",

    "button.background": "#7C8CFF",
    "button.foreground": "#0D0F12",
    "button.hoverBackground": "#8C9AFF",

    "panel.background": "#101318",
    "panel.border": "#242831",

    "terminal.background": "#0D0F12",
    "terminal.foreground": "#E6E8EB",
    "terminalCursor.foreground": "#7C8CFF",
    "terminal.border": "#242831",

    "scrollbarSlider.background": "#252A30",
    "scrollbarSlider.hoverBackground": "#343A43",
    "scrollbarSlider.activeBackground": "#454C57",

    "progressBar.background": "#7C8CFF",

    "gitDecoration.addedResourceForeground": "#62C58B",
    "gitDecoration.modifiedResourceForeground": "#E5B567",
    "gitDecoration.deletedResourceForeground": "#F06A6A",
    "gitDecoration.untrackedResourceForeground": "#68C6A5",
    "gitDecoration.renamedResourceForeground": "#61C4D8",
    "gitDecoration.ignoredResourceForeground": "#686F79"
  },

  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#686F79"
      }
    },
    {
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#7C8CFF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": {
        "foreground": "#69B7FF"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#C49AFF"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template"
      ],
      "settings": {
        "foreground": "#68C6A5"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.numeric.integer",
        "constant.numeric.float"
      ],
      "settings": {
        "foreground": "#E5B567"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other",
        "constant.character"
      ],
      "settings": {
        "foreground": "#F29E74"
      }
    },
    {
      "scope": [
        "constant.language.boolean"
      ],
      "settings": {
        "foreground": "#E5B567"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#E6E8EB"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#C8CDD4"
      }
    },
    {
      "scope": [
        "support.type.property-name",
        "meta.object-literal.key",
        "variable.other.property"
      ],
      "settings": {
        "foreground": "#82C7D9"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#AEB4BD"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#8A919B"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#F06A6A"
      }
    }
  ]
}